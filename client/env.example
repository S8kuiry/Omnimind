# Copy to .env.local for local dev. On Vercel, set at build time (NEXT_PUBLIC_*).

# Main Omnimind API (chat/docs)
# NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Email agent server
# Local:
# NEXT_PUBLIC_EMAIL_AGENT_SERVER_URL=http://localhost:8000
# Production (auto-detected if omitted on non-localhost hosts):
NEXT_PUBLIC_EMAIL_AGENT_SERVER_URL=https://omnimind-6ub9.onrender.com
