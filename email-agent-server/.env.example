# Copy to .env for local dev. On Render, set these in the dashboard Environment tab.

# ── MongoDB (required) ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=email_agent
# MONGODB_USE_PUBLIC_DNS=false

# ── Google OAuth (required) ────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
# Local:
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
# Production (Render):
# GOOGLE_REDIRECT_URI=https://omnimind-6ub9.onrender.com/auth/callback

# ── Frontend / CORS (required in production) ─────────────────────
FRONTEND_URL=http://localhost:3000
# Production example:
# FRONTEND_URL=https://your-app.vercel.app
# CORS_EXTRA_ORIGINS=https://your-app.vercel.app

# ── Security (required) ────────────────────────────────────────────
SECRET_KEY=generate-a-long-random-string-at-least-32-chars

# ── Gmail Pub/Sub push (required for instant mail + Render wake) ───
GMAIL_PUSH_ENABLED=true
GMAIL_PUBSUB_TOPIC=projects/omnimind-494002/topics/gmail-notifications
# Subscription is configured in GCP Console (push → /webhooks/gmail).
# IAM on topic: gmail-api-push@system.gserviceaccount.com → Pub/Sub Publisher

# ── LLM (at least one required) ────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Optional tuning ────────────────────────────────────────────────
AUTO_SEND_ENABLED=true
INGEST_INTERVAL_SECONDS=900
CLEANUP_INTERVAL_SECONDS=3600
DB_RETENTION_DAYS=60
PORT=8000
